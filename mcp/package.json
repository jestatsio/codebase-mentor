{
  "name": "codebase-mentor-mcp",
  "version": "0.2.0",
  "description": "Source-grounded codebase onboarding for MCP clients. Read-only project discovery, architecture prompts, and reusable templates. By JEStats.",
  "license": "MIT",
  "author": "Eric Hare (JEStats)",
  "homepage": "https://github.com/jestatsio/codebase-mentor#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jestatsio/codebase-mentor.git",
    "directory": "mcp"
  },
  "bugs": {
    "url": "https://github.com/jestatsio/codebase-mentor/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "agents",
    "onboarding",
    "codebase",
    "developer-tools",
    "architecture",
    "jestats"
  ],
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "codebase-mentor-mcp": "build/index.js"
  },
  "files": [
    "build"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-bundled.mjs",
    "prepack": "npm run build",
    "test": "npm run build && node tests/smoke.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2"
  }
}
